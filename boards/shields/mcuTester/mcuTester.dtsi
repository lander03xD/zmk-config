#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    default_kscan: kscan {
    // https://zmk.dev/docs/config/kscan#direct-gpio-driver
        compatible = "zmk,kscan-gpio-direct";
        label = "default_kscan";
        wakeup-source;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <42>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) 
            RC(0,10) RC(0,11) RC(0,12) 
            RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17) RC(0,18) RC(0,19) RC(0,20)
            
            
            RC(0,21) RC(0,22) RC(0,23) RC(0,24) RC(0,25) RC(0,26) RC(0,27) RC(0,28) RC(0,29) RC(0,30) 
            RC(0,31) RC(0,32) RC(0,33) 
            RC(0,34) RC(0,35) RC(0,36) RC(0,37) RC(0,38) RC(0,39) RC(0,40) RC(0,41)  
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&default_kscan>;
        transform = <&default_transform>; 
    };

    chosen {
        zmk,physical-layout = &physical_layout0;
    };

};

